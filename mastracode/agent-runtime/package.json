{
  "name": "@factory/agent-runtime",
  "version": "0.1.0",
  "private": true,
  "description": "Factory's agent runtime seam: the contracts every agent runtime adapter implements, plus the Factory-owned event log, event hub and interaction broker.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./browser": {
      "import": {
        "types": "./dist/browser.d.ts",
        "default": "./dist/browser.js"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown --silent --config tsdown.config.ts",
    "build:lib": "pnpm build",
    "check": "tsc --noEmit",
    "test:unit": "vitest run",
    "test": "vitest run",
    "lint": "oxlint --type-aware ."
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@internal/lint": "workspace:*",
    "@internal/types-builder": "workspace:*",
    "@mastra/core": "workspace:*",
    "@types/node": "22.19.15",
    "tsdown": "0.23.1",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@mastra/core": ">=1.68.0-0 <2.0.0-0",
    "zod": "^3.25.0 || ^4.0.0"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24.0.0"
  }
}
