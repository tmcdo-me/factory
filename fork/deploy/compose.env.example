# factory - the Factory server (tmcdo-me/factory, fork/deploy/compose.yaml). In homelab-compose this file
# is the stack's .env.example: required secrets are op:// references the deploy job resolves, optional
# ones are blank with their Destination. Never put a real value in this file.
TZ=America/Chicago
APPDATA_ROOT=/srv/apps

# The image: the full commit SHA of tmcdo-me/factory whose `Fork image` run published
# ghcr.io/tmcdo-me/factory:<sha> (a deploy is a PR that moves it). A placeholder until the first one.
FACTORY_IMAGE_TAG=0000000000000000000000000000000000000000
# Loopback port for cloudflared-truenas (the webhook route's origin is http://127.0.0.1:<this>).
FACTORY_PORT=5873

# The URL people open; unchanged by the move from mac-mini.
MASTRACODE_PUBLIC_URL=https://factory.tail99d67.ts.net

# Sign-in through Pocket ID: the client mac-mini's server uses now (redirect URI
# https://factory.tail99d67.ts.net/auth/callback, so nothing changes in Pocket ID).
OIDC_ISSUER=https://id.tail99d67.ts.net
OIDC_CLIENT_ID=op://Homelab/factory-oidc/CLIENT_ID
OIDC_CLIENT_SECRET=op://Homelab/factory-oidc/CLIENT_SECRET
OIDC_DISPLAY_NAME=Pocket ID
# 32 characters or more; signs the session cookie. Changing it signs everyone out, nothing else.
FACTORY_SESSION_SECRET=op://Homelab/factory/FACTORY_SESSION_SECRET

# The key the database's secrets are encrypted with: the one mac-mini's .env has today. Losing it makes
# the stored model keys and integration secrets unreadable; 1Password is its backup.
FACTORY_CREDENTIAL_ENCRYPTION_KEY=op://Homelab/factory/FACTORY_CREDENTIAL_ENCRYPTION_KEY
# Destination: op://Homelab/factory/FACTORY_CREDENTIAL_ENCRYPTION_PREVIOUS_KEYS (only after a key rotation)
FACTORY_CREDENTIAL_ENCRYPTION_PREVIOUS_KEYS=

# Fly.io Sprites, one per session.
SPRITES_TOKEN=op://Homelab/factory/SPRITES_TOKEN
FACTORY_SPRITES_REGION=ord
# One prefix per deployment sharing the token (a second Factory, say the Mini's dev one, needs another
# that is not a prefix of this one, such as factory-dev).
FACTORY_SPRITES_PREFIX=factory

# Claude Code's login inside the Sprites (`claude setup-token`, the owner's subscription).
CLAUDE_CODE_OAUTH_TOKEN=op://Homelab/factory/CLAUDE_CODE_OAUTH_TOKEN

# The GitHub App (the one mac-mini's server uses).
GITHUB_APP_ID=op://Homelab/factory-github-app/GITHUB_APP_ID
GITHUB_APP_PRIVATE_KEY=op://Homelab/factory-github-app/GITHUB_APP_PRIVATE_KEY
GITHUB_APP_CLIENT_ID=op://Homelab/factory-github-app/GITHUB_APP_CLIENT_ID
GITHUB_APP_CLIENT_SECRET=op://Homelab/factory-github-app/GITHUB_APP_CLIENT_SECRET
GITHUB_APP_SLUG=op://Homelab/factory-github-app/GITHUB_APP_SLUG
GITHUB_APP_WEBHOOK_SECRET=op://Homelab/factory-github-app/GITHUB_APP_WEBHOOK_SECRET

# Optional; blank is the default (mastracode/web/.env.schema).
MASTRACODE_GITHUB_AUTHORIZED_BOTS=
MASTRACODE_DISPATCH_MAX_IN_FLIGHT=
FACTORY_CLAUDE_AGENT_IDLE_CLOSE_MS=
FACTORY_CLAUDE_AGENT_BACKGROUND_MAX_MS=

# The online snapshot sidecar: daily at this local time, ahead of the 02:30 PBS window and the 08:00
# backup-verify pass, keeping this many dated copies.
FACTORY_SNAPSHOT_AT=02:10
FACTORY_BACKUP_KEEP=7
